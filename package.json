{
	"name": "hono-react-vite-app",
	"type": "module",
	"workspaces": [
		"apps/backend",
		"apps/frontend"
	],
	"scripts": {
		"dev": "pnpm --parallel --stream --filter './apps/**' run dev",
		"build": "pnpm --filter @app/frontend build && pnpm --filter @app/backend build",
		"typecheck": "pnpm --filter @app/frontend typecheck && pnpm --filter @app/backend typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"deploy:frontend": "pnpm --filter @app/frontend deploy",
		"deploy:backend": "pnpm --filter @app/backend deploy"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12"
	},
	"packageManager": "pnpm@11.7.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
