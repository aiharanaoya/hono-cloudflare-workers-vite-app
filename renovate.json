{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"npmrc": "//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}",
	"lockFileMaintenance": {
		"enabled": true
	},
	"packageRules": [
		{
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true
		}
	],
	"minimumReleaseAge": "3 days"
}
